# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for privileged operations; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (AI Studio -> Get API key)
GEMINI_API_KEY=
# Model id to use, e.g. a free-tier Gemini model.
GEMINI_MODEL=
